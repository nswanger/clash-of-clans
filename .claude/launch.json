{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-e2e",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_E2E_MODE=true pnpm --filter @cwl/web exec vite --host 127.0.0.1 --port 5183 --base /"
      ],
      "port": 5183,
      "url": "http://127.0.0.1:5183"
    },
    {
      "name": "design-prototypes",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server 5184 --bind 127.0.0.1 --directory design"
      ],
      "port": 5184,
      "url": "http://127.0.0.1:5184"
    }
  ]
}
