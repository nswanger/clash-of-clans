# Deployment target for the UnRaid collector host.
#
# Copy to deploy/unraid/target.env and fill in the real values. That path is
# gitignored: this repository is public, so host and account details must never
# be committed here. The values themselves are not secrets — they are private
# infrastructure detail, and the rule is the same either way.
#
# This file holds connection detail only. Collector secrets
# (CLASH_API_TOKEN, SUPABASE_SERVICE_ROLE_KEY) live solely in
# /mnt/user/appdata/cwl-collector/collector.env on the host, mode 600, and must
# not be copied into this repository under any name.
#
#   set -a; . deploy/unraid/target.env; set +a
#
# The source of truth for the host's SSH setup, key management, and network
# layout is `Personal-Vault/Server Docs`. Update that first; this file is a
# local convenience copy so a session does not have to go looking for it.

# SSH destination used by every ssh/scp command in docs/runbooks/unraid.md.
UNRAID_SSH=user@host

# Optional fallback when mDNS name resolution is unavailable on the LAN.
UNRAID_SSH_FALLBACK=

# App-data directory holding the compose file, image selector, and collector.env.
COLLECTOR_APPDATA=/mnt/user/appdata/cwl-collector
